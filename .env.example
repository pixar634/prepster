# Copy to .env.local for a local run. Never commit a real key; .env* is gitignored.

# Off by default: the server never spends a key of its own, and a request without the visitor's key is refused.
# Turn on only on your own machine, to run real preps with the key below. Never set it on the hosted site.
PREPSTER_SERVER_KEY=off

# Your Anthropic API key (console.anthropic.com), used only when PREPSTER_SERVER_KEY=on.
ANTHROPIC_API_KEY=
